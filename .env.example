# ─────────────────────────────────────────────
# e-Registro Brasil — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# ─────────────────────────────────────────────

# Django
SECRET_KEY=substitua-por-uma-chave-secreta-segura-de-50-caracteres
DEBUG=False
ALLOWED_HOSTS=eregistrobrasil.com.br,www.eregistrobrasil.com.br
CSRF_TRUSTED_ORIGINS=https://eregistrobrasil.com.br,https://www.eregistrobrasil.com.br
SITE_URL=https://eregistrobrasil.com.br

# Banco de Dados PostgreSQL
DB_NAME=eregistro_brasil
DB_USER=eregistro_user
DB_PASSWORD=senha_segura_aqui
DB_HOST=db
DB_PORT=5432

# Redis
REDIS_PASSWORD=redis_senha_segura
REDIS_URL=redis://:redis_senha_segura@redis:6379/0

# Celery
CELERY_BROKER_URL=redis://:redis_senha_segura@redis:6379/0
CELERY_RESULT_BACKEND=redis://:redis_senha_segura@redis:6379/1

# Email (configure com seu provedor SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=seuemail@gmail.com
EMAIL_HOST_PASSWORD=senha_de_app_gmail
DEFAULT_FROM_EMAIL=E-Registro Brasil <noreply@eregistrobrasil.com.br>

# Mercado Pago (preencha com suas credenciais de produção)
MP_PUBLIC_KEY=APP_USR-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MP_ACCESS_TOKEN=APP_USR-0000000000000000-xxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-000000000
